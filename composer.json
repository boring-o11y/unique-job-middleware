{
    "name": "boring-o11y/unique-job-middleware",
    "description": "A queue job middleware that checks a ShouldBeUnique job's lock again when it runs, and skips the copies queued past it.",
    "keywords": ["laravel", "queue", "unique", "ShouldBeUnique", "middleware", "horizon"],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/boring-o11y/unique-job-middleware/issues",
        "source": "https://github.com/boring-o11y/unique-job-middleware"
    },
    "require": {
        "php": "^8.1",
        "illuminate/bus": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/horizon": "^5.24",
        "orchestra/testbench": "^8.14|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "predis/predis": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "BoringO11y\\UniqueJobMiddleware\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BoringO11y\\UniqueJobMiddleware\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BoringO11y\\UniqueJobMiddleware\\UniqueJobMiddlewareServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
